# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Postgres (used by compose.yaml to create the database)
POSTGRES_DB=kinhospital
POSTGRES_USER=kinhospital
POSTGRES_PASSWORD=change-me
# Host port for the Docker database (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_HOST_PORT=5433

# Backend. When running in Docker, compose.yaml overrides DATABASE_URL to use the `db` host.
DATABASE_URL=postgresql+psycopg://kinhospital:change-me@localhost:5433/kinhospital
CORS_ORIGINS=http://localhost:5173

# Admin login for /admin. Use a long random password and secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
